<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:UI.ER.ViewModels.ViewModels"
        xmlns:controls="clr-namespace:UI.ER.AvaloniaUI.Controls"
        xmlns:pages="clr-namespace:UI.ER.AvaloniaUI.Pages"
        x:Class="UI.ER.AvaloniaUI.Pages.ActuacioSetWindow"
        HorizontalContentAlignment="Stretch"
        Title="Actuació, llistat"
        Width="1000" Height="700" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        >
    <Design.DataContext>
        <viewModels:ActuacioSetViewModel />
    </Design.DataContext>

    <Grid>

        <DockPanel>

            <!-- ==================== CERCA ==================== -->
            <Border DockPanel.Dock="Top" Classes="BarraFiltres">
                <StackPanel Spacing="10">
                    <!-- Input de cerca -->
                    <DockPanel>
                        <avalonia:MaterialIcon DockPanel.Dock="Left"
                                               Kind="BookOpenVariant" Width="28" Height="28"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding SearchString}"
                             BorderBrush="{Binding $self.Foreground}" BorderThickness="1"
                             Classes="solo" Theme="{StaticResource SoloTextBox}"
                             Watermark="Cercar per nom, cognoms, tag i centre de l'alumne i descripció, tipus i curs de l'actuació."
                             CornerRadius="32">
                        <TextBox.InnerLeftContent>
                            <Border Height="{Binding $parent[TextBox].Height}" Width="{Binding $self.Bounds.Height}">
                                <avalonia:MaterialIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Kind="Magnify" Width="20" Height="20" />
                            </Border>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    </DockPanel>
                    <!-- Filtres i info -->
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="Xip" Margin="8,0,0,0"
                                IsVisible="{Binding PaginatedMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding PaginatedMsg}" Classes="Caption"
                                   Foreground="{DynamicResource InfoBrush}"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ToggleSwitch VerticalAlignment="Center"
                                        IsChecked="{Binding NomesAlumnesActius}"
                                        Content="Només alumnes actius "
                                        Margin="0"
                                        Classes="LeftHeader" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ==================== CARREGANT ==================== -->
            <controls:IndicadorCarrega DockPanel.Dock="Top" IsVisible="{Binding Loading}" />

            <!-- ==================== ERRORS ==================== -->
            <ItemsControl DockPanel.Dock="Top"
                          Margin="16,4"
                          ItemsSource="{Binding BrokenRules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Classes="Error" Text="{Binding, Mode=OneWay}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==================== RESULTATS ==================== -->
            <ListBox Margin="8,4,8,80"
                     ItemsSource="{Binding MyItems, Mode=OneWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <pages:ActuacioRowUserCtrl/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>

        <!-- ==================== FAB AFEGIR ==================== -->
        <material:FloatingButton Classes="Afegir" IsExtended="True"
                                 Command="{Binding Create}"
                                 Content="Nova actuació"
                                 ToolTip.Tip="Afegir una nova actuació (Ctrl++)" />

    </Grid>
</Window>
