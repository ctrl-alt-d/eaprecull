<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:controls="clr-namespace:UI.ER.AvaloniaUI.Controls"
        x:Class="UI.ER.AvaloniaUI.Pages.AlumneUpdateWindow"
        HorizontalContentAlignment="Stretch"
        Title="Alumne, detall i modificació de dades"        
        Width="1100" Height="600" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        >

    <Grid>
    <ScrollViewer>
        <StackPanel Orientation="Vertical"
                    Margin="24, 20">

            <!-- ==================== DADES PERSONALS ==================== -->
            <Border Classes="Seccio">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <avalonia:MaterialIcon Kind="AccountOutline" Width="22" Height="22" 
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Dades personals" Classes="Subtitle1" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="350,*">
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="6,4"
                                    Text="{Binding Nom}"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Nom" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="6,4"
                                    Text="{Binding Cognoms}"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Cognoms" />
                        <controls:DateInput Grid.Row="1" Grid.Column="0" Margin="6,4"
                                    DateText="{Binding DataNaixementTxt}"
                                    Label="Data naixement (dd.mm.aaaa)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="6,4"
                                    Text="{Binding Tags}"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Tags (paraules clau per cercar)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== DADES ACADÈMIQUES ==================== -->
            <Border Classes="Seccio">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <avalonia:MaterialIcon Kind="SchoolOutline" Width="22" Height="22" 
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Dades acadèmiques" Classes="Subtitle1" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <avalonia:MaterialIcon Kind="AlertOutline" Width="18" Height="18" 
                                               Foreground="{DynamicResource DangerStrongBrush}" Margin="15,0,5,0"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding MissatgeAlertaCursTxt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding MissatgeAlertaCursTxt}" Classes="Caption" 
                                   Foreground="{DynamicResource DangerStrongBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding MissatgeAlertaCursTxt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="350,*">
                        <controls:LookupInput Grid.Row="0" Grid.Column="0" Margin="6,4"
                                    Text="{Binding CursDarreraActualitacioDadesTxt}"
                                    Label="Curs Darrera Actualització Dades"
                                    LookupCommand="{Binding CursDarreraActualitacioDadesLookupCommand}"
                                    ClearCommand="{Binding CursDarreraActualitacioDadesClearCommand}" />
                        <controls:LookupInput Grid.Row="0" Grid.Column="1" Margin="6,4"
                                    Text="{Binding CentreTxt}"
                                    Label="Centre on estudia l'alumne"
                                    LookupCommand="{Binding CentreLookupCommand}"
                                    ClearCommand="{Binding CentreClearCommand}" />
                        <controls:LookupInput Grid.Row="1" Grid.Column="0" Margin="6,4"
                                    Text="{Binding EtapaActualTxt}"
                                    Label="Etapa que cursa l'alumne"
                                    LookupCommand="{Binding EtapaActualLookupCommand}"
                                    ClearCommand="{Binding EtapaActualClearCommand}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="6,4"
                                    Text="{Binding NivellActual}"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Nivell actual (exs: 1, 1r, AO, ...)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== NESE ==================== -->
            <Border Classes="Seccio Avis">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <avalonia:MaterialIcon Kind="AlertCircleOutline" Width="22" Height="22" 
                                               Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="NESE (Necessitats Específiques)" Classes="Subtitle1" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="350,*">
                        <controls:DateInput Grid.Row="0" Grid.Column="0" Margin="6,4"
                                    DateText="{Binding DataInformeNESENEETxt}"
                                    Label="Data informe NESE NEE (dd.mm.aaaa)" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="6,4"
                                    Text="{Binding ObservacionsNESENEE}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="60"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Observacions NESE NEE" />
                        <controls:DateInput Grid.Row="1" Grid.Column="0" Margin="6,4"
                                    DateText="{Binding DataInformeNESENoNEETxt}"
                                    Label="Data informe NESE NO NEE (dd.mm.aaaa)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="6,4"
                                    Text="{Binding ObservacionsNESENoNEE}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="60"
                                    UseFloatingWatermark="True"
                                    Classes="Filled"
                                    assists:TextFieldAssist.Label="Observacions NESE NO NEE" />
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl Margin="10,5,10,5" ItemsSource="{Binding BrokenRules}">            
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Classes="Error" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Espai perquè el FAB no tapi contingut -->
            <Border Height="80" />

        </StackPanel>

    </ScrollViewer>

        <!-- ==================== FAB DESAR ==================== -->
        <material:FloatingButton Classes="Desar Ancorat" IsExtended="True"
                                 Command="{Binding SubmitCommand}" />

    </Grid>
</Window>