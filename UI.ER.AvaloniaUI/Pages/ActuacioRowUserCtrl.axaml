<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:UI.ER.ViewModels.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.ER.AvaloniaUI.Pages.ActuacioRowUserCtrl">
    <Design.DataContext>
        <viewModels:ActuacioRowViewModel />
    </Design.DataContext>


    <Border Classes="Fitxa Apareix" Padding="10"
            Classes.Desapareix="{Binding IsDeleting}"
            RenderTransform="translate(0,0)">

        <DockPanel>

            <Button DockPanel.Dock="Left"
                    IsVisible="{Binding ModeLookup}"
                    Command="{Binding SeleccionarCommand}"
                    Classes="LookupFinishedCss Flat" />

            <Button DockPanel.Dock="Right"
                    Command="{Binding UpdateCommand}"
                    Classes="EditarCss Flat" />

            <Button DockPanel.Dock="Right"
                    Command="{Binding VeureExpedientAlumneCommand}"
                    ToolTip.Tip="Veure expedient de l'alumne"
                    Classes="Flat" >
                <avalonia:MaterialIcon Kind="FolderAccount" />
            </Button>

            <Button DockPanel.Dock="Right"
                    Command="{Binding EditarAlumneCommand}"
                    ToolTip.Tip="Editar dades de l'alumne"
                    Classes="Flat" >
                <avalonia:MaterialIcon Kind="AccountEdit" />
            </Button>

            <StackPanel Orientation="Vertical"
                        DockPanel.Dock="Left">

                <!-- Línia 1: Data + Curs + Durada -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Classes="Xip" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <avalonia:MaterialIcon Kind="CalendarOutline" Width="14" Height="14" 
                                                   Foreground="{DynamicResource InfoBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataTxt}" Classes="Body2" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CursActuacio}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DuradaTxt}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" 
                               VerticalAlignment="Center"
                               IsVisible="{Binding DuradaTxt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Línia 2: Alumne + Tipus (badge) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Classes="Body1" Text="{Binding AlumneNom}" FontWeight="SemiBold" 
                               MinWidth="250" Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource AccentContainerBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TipusActuacio}" Classes="Caption" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding CentreActuacio}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Línia 3: Descripció (resum) -->
                <TextBlock Classes="Body2" Text="{Binding DescripcioActuacio}" 
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                           IsVisible="{Binding DescripcioActuacio, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <ItemsControl Margin="10,4,10,0"
                              IsVisible="{Binding BrokenRules.Count}"
                              ItemsSource="{Binding BrokenRules}">            
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Classes="Error" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>                     
            
        </DockPanel>                     
    </Border>

</UserControl>    